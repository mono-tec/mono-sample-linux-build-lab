#cloud-config

package_update: true
package_upgrade: false

packages:
  - git
  - curl
  - openssh-server
  - dotnet-runtime-10.0
  - file

users:
  - name: ubuntu
    gecos: Ubuntu
    groups:
      - adm
      - sudo
      - video
    shell: /bin/bash
    sudo:
      - ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false

write_files:
  # macvlan側NICでIPv4アドレスを取得する設定
  - path: /etc/netplan/60-eth1.yaml
    owner: root:root
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          eth1:
%{ if network_mode == "dhcp" }
            dhcp4: true
%{ else }
            dhcp4: false
            addresses:
              - ${guest_ipv4_address}/${guest_ipv4_prefix}
%{ endif }
            dhcp6: true

  # GitHub Releaseからカメラ用debパッケージを取得し、
  # インストール後にsystemdのoneshotサービスを実行するスクリプト
  - path: /usr/local/bin/install-linux-build-lab-camera.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      PACKAGE_NAME="${package_name}"
      PACKAGE_VERSION="${package_version}"
      RELEASE_TAG="v$${PACKAGE_VERSION}"
      PACKAGE_FILE="$${PACKAGE_NAME}_$${PACKAGE_VERSION}_amd64.deb"
      DOWNLOAD_FILE="/tmp/$${PACKAGE_FILE}"
      DOWNLOAD_URL="https://github.com/${github_repository}/releases/download/$${RELEASE_TAG}/$${PACKAGE_FILE}"
      SERVICE_NAME="$${PACKAGE_NAME}.service"

      echo "[INFO] Package name: $${PACKAGE_NAME}"
      echo "[INFO] Package version: $${PACKAGE_VERSION}"
      echo "[INFO] Release tag: $${RELEASE_TAG}"
      echo "[INFO] Download URL: $${DOWNLOAD_URL}"
      echo "[INFO] Service name: $${SERVICE_NAME}"

      curl \
        --fail \
        --location \
        --retry 3 \
        --retry-delay 5 \
        --output "$${DOWNLOAD_FILE}" \
        "$${DOWNLOAD_URL}"

      apt-get install -y "$${DOWNLOAD_FILE}"

      systemctl daemon-reload
      systemctl start "$${SERVICE_NAME}"

      rm -f "$${DOWNLOAD_FILE}"

      echo "[INFO] Camera package installation completed."

runcmd:
  # SSHパスワード認証は無効のまま、
  # 公開鍵認証を許可するためubuntuアカウントのロックを解除
  - |
    PASSWORD_HASH=$(openssl passwd -6 "$(openssl rand -hex 32)")
    usermod -p "$PASSWORD_HASH" ubuntu

  # 念のためubuntuユーザーがvideoグループへ
  # 登録されていることを保証
  - usermod -aG video ubuntu

  # SSHサーバーを起動
  - systemctl enable --now ssh

  # macvlan側NICの設定を反映
  - netplan generate
  - netplan apply

  # .NET Runtime情報をログへ保存
  - dotnet --info > /var/log/dotnet-runtime-info.log 2>&1

  # カメラ用debパッケージを取得してインストールし、
  # systemdのoneshotサービスから静止画を取得
  - /usr/local/bin/install-linux-build-lab-camera.sh > /var/log/linux-build-lab-camera-install.log 2>&1