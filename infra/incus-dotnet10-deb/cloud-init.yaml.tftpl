#cloud-config

# ============================================================
# LinuxBuildLab.Sample debパッケージ検証環境
#
# GitHub Releasesに公開されている最新のdebを取得し、
# 新規Ubuntu環境へインストールできることを確認します。
#
# この環境は過去バージョンの再現ではなく、
# 「現在の最新パッケージが正常に導入できるか」
# を確認する用途としています。
# ============================================================

package_update: true
package_upgrade: false

# ============================================================
# 使用するパッケージ
#
# jq:
#   GitHub Releases APIの結果から
#   最新debのURLを抽出するために使用します。
#
# dotnet-runtime-10.0:
#   LinuxBuildLab.Sampleの実行に使用します。
# ============================================================
packages:
  - git
  - curl
  - jq
  - openssh-server
  - dotnet-runtime-10.0

# ============================================================
# ubuntuユーザー設定
# ============================================================
users:
  - name: ubuntu
    gecos: Ubuntu
    groups:
      - adm
      - sudo
    shell: /bin/bash
    sudo:
      - ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false

# ============================================================
# 最新debをGitHub Releasesから取得するスクリプト
# ============================================================
write_files:

  - path: /usr/local/bin/install-linux-build-lab-sample.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash

      set -euo pipefail

      # --------------------------------------------------------
      # この検証環境で使用する固定値
      #
      # Terraform側からリポジトリ名やパッケージ名を
      # 渡す必要はありません。
      # --------------------------------------------------------
      PACKAGE_NAME="linux-build-lab-sample"
      GITHUB_REPOSITORY="mono-tec/mono-sample-linux-build-lab"

      # GitHub Releasesのlatest API
      LATEST_RELEASE_API="https://api.github.com/repos/$${GITHUB_REPOSITORY}/releases/latest"

      echo "[INFO] Package name: $${PACKAGE_NAME}"
      echo "[INFO] GitHub repository: $${GITHUB_REPOSITORY}"
      echo "[INFO] Latest release API: $${LATEST_RELEASE_API}"

      # --------------------------------------------------------
      # 最新Releaseからamd64向けdebを探します。
      #
      # 例:
      # linux-build-lab-sample_0.3.3_amd64.deb
      # --------------------------------------------------------
      PACKAGE_URL="$$( \
        curl \
          --fail \
          --silent \
          --show-error \
          --location \
          "$${LATEST_RELEASE_API}" \
        | jq -r \
            --arg PACKAGE_NAME "$${PACKAGE_NAME}" \
            '.assets[]
             | select(.name | startswith($PACKAGE_NAME + "_"))
             | select(.name | endswith("_amd64.deb"))
             | .browser_download_url' \
        | head -n 1 \
      )"

      # --------------------------------------------------------
      # debが見つからない場合はエラー終了
      # --------------------------------------------------------
      if [[ -z "$${PACKAGE_URL}" || "$${PACKAGE_URL}" == "null" ]]; then
        echo "[ERROR] Latest release deb package was not found."
        exit 1
      fi

      PACKAGE_FILE="$$(basename "$${PACKAGE_URL}")"
      DOWNLOAD_FILE="/tmp/$${PACKAGE_FILE}"

      echo "[INFO] Package URL: $${PACKAGE_URL}"
      echo "[INFO] Package file: $${PACKAGE_FILE}"

      # --------------------------------------------------------
      # debをダウンロード
      # --------------------------------------------------------
      curl \
        --fail \
        --location \
        --retry 3 \
        --retry-delay 5 \
        --output "$${DOWNLOAD_FILE}" \
        "$${PACKAGE_URL}"

      # --------------------------------------------------------
      # debをインストール
      #
      # aptを使用することで、
      # 依存パッケージがある場合もあわせて解決します。
      # --------------------------------------------------------
      apt-get install -y "$${DOWNLOAD_FILE}"

      # --------------------------------------------------------
      # パッケージにsystemd Unitが含まれている場合に備えて、
      # systemd設定を再読込します。
      # --------------------------------------------------------
      systemctl daemon-reload

      # --------------------------------------------------------
      # ダウンロードした一時ファイルを削除
      # --------------------------------------------------------
      rm -f "$${DOWNLOAD_FILE}"

      echo "[INFO] Sample package installation completed."

# ============================================================
# 初回起動時に実行する処理
# ============================================================
runcmd:

  # ----------------------------------------------------------
  # 公開鍵SSHを利用できるようにubuntuユーザーを有効化
  # ----------------------------------------------------------
  - |
    PASSWORD_HASH=$(openssl passwd -6 "$(openssl rand -hex 32)")
    usermod -p "$PASSWORD_HASH" ubuntu

  # SSHサーバーを起動
  - systemctl enable --now ssh

  # ----------------------------------------------------------
  # .NET Runtime情報をログへ保存
  # ----------------------------------------------------------
  - dotnet --info > /var/log/dotnet-runtime-info.log 2>&1

  # ----------------------------------------------------------
  # GitHub Releasesのlatestから最新Sample debを取得し、
  # インストールします。
  # ----------------------------------------------------------
  - /usr/local/bin/install-linux-build-lab-sample.sh > /var/log/linux-build-lab-sample-install.log 2>&1