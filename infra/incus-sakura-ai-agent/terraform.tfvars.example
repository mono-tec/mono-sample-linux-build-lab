# ============================================================
# Linux Build Lab
# OpenCode + Sakura AI Engine
#
# このファイルを terraform.tfvars としてコピーし、
# 利用環境に合わせて値を変更してください。
#
# terraform.tfvars にはAPIトークンとSSH公開鍵が含まれるため、
# Gitへ登録しないでください。
# ============================================================

# ------------------------------------------------------------
# Incusコンテナ設定
# ------------------------------------------------------------

instance_name = "ubuntu2404-sakura-ai-agent"

image = "images:ubuntu/24.04/cloud"

cpu_count   = 2
memory_limit = "4GiB"

# ------------------------------------------------------------
# LAN接続設定
# ------------------------------------------------------------

# Incusへ追加するLAN側NICのデバイス名
lan_device_name = "lan0"

# Ubuntuホストで物理LANへ接続しているインターフェース名
# 実際の名称は次のコマンドなどで確認してください。
#
# ip -brief link show
#
lan_interface = "eno1"

# Incusコンテナ内で使用するLAN側NIC名
guest_interface_name = "eth1"

# IPv4設定方式
#
# dhcp  : DHCPからIPv4アドレスを取得
# static: guest_ipv4_addressとguest_ipv4_prefixを使用
#
network_mode = "dhcp"

# network_modeがstaticの場合に指定
guest_ipv4_address = ""

# 例:
# guest_ipv4_address = "192.168.1.50"

guest_ipv4_prefix = 24

# ------------------------------------------------------------
# SSH公開鍵設定
# ------------------------------------------------------------

# Windows側などで作成したSSH公開鍵を指定します。
# 秘密鍵は指定しないでください。
#
# 例:
# ssh_public_key = "ssh-ed25519 AAAAC3... mono-linux-build-lab"
#
ssh_public_key = "YOUR_SSH_PUBLIC_KEY"

# ------------------------------------------------------------
# さくらのAI Engine設定
# ------------------------------------------------------------

# OpenAI互換APIのBase URL
sakura_ai_base_url = "https://api.ai.sakura.ad.jp/v1"

# さくらのAI Engineで発行したアカウントトークン
#
# この値は次の場所へ保存されます。
#
# - terraform.tfvars
# - terraform.tfstate
# - Incusコンテナのcloud-init設定
# - /home/ubuntu/.config/opencode/opencode.json
#
sakura_ai_token = "YOUR_SAKURA_AI_ACCOUNT_TOKEN"

# 基盤モデル無償プランで使用するモデル
#
# 選択可能:
# - gpt-oss-120b
# - llm-jp-3.1-8x13b-instruct4
# - preview/Kimi-K2.6
#
sakura_ai_model = "preview/Kimi-K2.6"

# ------------------------------------------------------------
# OpenCode作業ディレクトリ
# ------------------------------------------------------------

workspace_directory = "/home/ubuntu/workspace"