#cloud-config

package_update: true
package_upgrade: false

write_files:
  - path: /etc/netplan/60-eth1.yaml
    owner: root:root
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          eth1:
%{ if network_mode == "dhcp" ~}
            dhcp4: true
%{ else ~}
            dhcp4: false
            addresses:
              - ${guest_ipv4_address}/${guest_ipv4_prefix}
%{ endif }
            dhcp6: true

  - path: /usr/local/sbin/setup-postgresql-lab.sh
    owner: root:root
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      export DEBIAN_FRONTEND=noninteractive

      PG_VERSION="${postgresql_version}"
      POSTGRES_PASSWORD="${postgres_password}"

      echo "[INFO] Configure PGDG repository."

      apt-get update
      apt-get install -y ca-certificates curl postgresql-common

      install -d -m 0755 /usr/share/postgresql-common/pgdg

      curl \
        --fail \
        --location \
        --output /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc

      . /etc/os-release

      cat > /etc/apt/sources.list.d/pgdg.sources <<EOF
      Types: deb
      URIs: https://apt.postgresql.org/pub/repos/apt
      Suites: $${VERSION_CODENAME}-pgdg
      Components: main
      Signed-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
      EOF

      apt-get update

      apt-get install -y \
        "postgresql-$${PG_VERSION}" \
        "postgresql-client-$${PG_VERSION}"

      PG_CONF="/etc/postgresql/$${PG_VERSION}/main/postgresql.conf"
      PG_HBA="/etc/postgresql/$${PG_VERSION}/main/pg_hba.conf"

      echo "[INFO] Configure PostgreSQL remote access."

      sed -ri \
        "s/^[#[:space:]]*listen_addresses[[:space:]]*=.*/listen_addresses = '*'/" \
        "$${PG_CONF}"

      HBA_ENTRY="host    all    postgres    0.0.0.0/0    trust"

      if ! grep -Fq "$${HBA_ENTRY}" "$${PG_HBA}"; then
        cat >> "$${PG_HBA}" <<EOF

      # Linux Build Lab: disposable test environment only
      $${HBA_ENTRY}
      EOF
      fi

      echo "[INFO] Configure postgres administrator password."

      sudo -u postgres psql \
        -v ON_ERROR_STOP=1 \
        -c "ALTER ROLE postgres WITH LOGIN PASSWORD '$${POSTGRES_PASSWORD}';"

      systemctl enable postgresql
      systemctl restart postgresql

      {
        echo "PostgreSQL version:"
        psql --version

        echo
        echo "Cluster:"
        pg_lsclusters

        echo
        echo "Listening sockets:"
        ss -lntp | grep ':5432' || true

        echo
        echo "listen_addresses:"
        sudo -u postgres psql -tAc "SHOW listen_addresses;"

        echo
        echo "pg_hba.conf:"
        sudo -u postgres psql -tAc "SHOW hba_file;"

        echo
        echo "Lab trust entry:"
        grep -F "$${HBA_ENTRY}" "$${PG_HBA}" || true

        echo
        echo "Databases:"
        sudo -u postgres psql -lqt
      } > /var/log/postgresql-lab-setup.log 2>&1

      echo "[INFO] PostgreSQL lab setup completed."

runcmd:
  - netplan generate
  - netplan apply
  - /usr/local/sbin/setup-postgresql-lab.sh
